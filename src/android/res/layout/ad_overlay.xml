<?xml version="1.0" encoding="utf-8"?>
<!--
    Root container for IMA ad overlay.
    Added programmatically by IMASDKPlugin, this file is kept for reference.
    The VideoView and FrameLayout are created in Java to ensure correct z-order.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ima_ad_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <VideoView
        android:id="@+id/ima_ad_video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

</FrameLayout>
